NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Server-side: AI layer v2 (lib/ai/**) ---
# The task decides the provider, not a global switch — see lib/ai/tasks.ts.
# Chain per task: local Ollama (if configured, see below) -> Claude -> Gemini -> rule-based fallback.
# Every field below is optional; with none set, every AI button still works via its fallback.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_MODEL_LARGE=claude-sonnet-5
AI_MODEL_SMALL=claude-haiku-4-5-20251001
GEMINI_MODEL_LARGE=gemini-2.5-pro
GEMINI_MODEL_SMALL=gemini-2.5-flash
# Global monthly ceiling in USD, enforced server-side before every call (the tighter
# of this and the caller's tier's aiMonthlyBudgetUsd wins). At 100%, every task
# falls back to rule-based output automatically.
AI_MONTHLY_BUDGET_USD=5

# --- Server-side: local Ollama (optional accelerator, off by default) ---
# The endpoint address is NOT an env var — it's admin-managed in the `admin/settings`
# Firestore doc (stopgap CLI: `pnpm manage:ai-settings`) because it's not a secret and
# it changes. Only the values that guard it belong here.
OLLAMA_TOKEN=
OLLAMA_HEARTBEAT_SECRET=
ALLOW_INSECURE_OLLAMA=
# Only needed if the box sits behind a Cloudflare Access application (Zero Trust
# -> Access -> Service Auth) in front of the tunnel -- an additive layer on top
# of OLLAMA_TOKEN, not a replacement for it. Both headers are required together.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# --- Server-side: Firebase Admin (API routes + cron) ---
# base64-encode a Firebase service account JSON key: base64 -i serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Shared secret Vercel Cron must send as `Authorization: Bearer <value>`
CRON_SECRET=

# --- Server-side: Admin panel (Phase 4.5) ---
# The email that claims the one-time `owner` role the first time it signs in.
# Inert on every sign-in after that (see admin/settings.ownerBootstrapped) and
# on every other email. There is no OWNER_UIDS allowlist any more — every
# signed-in, non-disabled account can use the app; roles and the admin panel
# at /admin (owner/admin only) now govern access instead.
BOOTSTRAP_OWNER_EMAIL=

# --- Server-side: Vercel Blob (optional — paper PDF uploads) ---
# From the Vercel dashboard: Storage -> Blob -> create a store -> copy its
# read-write token. Without this, PDF upload is disabled with a clear message
# on the paper detail page; every other paper feature (3-pass reading, notes,
# groups, link-only papers) works regardless.
BLOB_READ_WRITE_TOKEN=

# --- Server-side: Google Calendar integration (plan/11.FocusOS-v2-Google-Calendar-Sync-Plan.md) ---
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web application).
# Enable the Calendar API first. The consent screen requests four scopes (see the SCOPES constant
# in lib/google-calendar-admin.ts, the source of truth for the exact list): calendar.app.created,
# calendar.events.readonly, calendar.calendarlist.readonly, and the non-sensitive `userinfo.email`
# (used only to display which Google account is connected).
# Without these set, the "Connect Google Calendar" button in Settings fails with a clear error;
# every other feature in the app works regardless.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must exactly match a redirect URI registered on that OAuth client
# (e.g. http://localhost:3000/api/integrations/google-calendar/callback in dev).
GOOGLE_OAUTH_REDIRECT_URI=
